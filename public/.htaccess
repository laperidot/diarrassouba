# DIARRASSOUBA — Apache (Hostinger)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forcer HTTPS (décommenter en production si FORCE_HTTPS n'est pas utilisé)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fichiers réels servis directement, le reste passe par index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Ne jamais servir de fichiers sensibles s'ils se retrouvaient ici
<FilesMatch "(^\.env|\.sql|\.sqlite|\.log|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|svg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Après la règle générale : le service worker et le manifeste ne doivent jamais rester en cache
  <FilesMatch "(sw\.js|\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "sw\.js$">
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>
