# ---------------------------------------------------------------
# DIARRASSOUBA IMPORT-EXPORT — configuration (copier en .env)
# Ne jamais versionner ni publier le fichier .env.
# ---------------------------------------------------------------
APP_NAME="DIARRASSOUBA IMPORT-EXPORT"
APP_ENV=production
APP_DEBUG=false
# URL publique, sans barre finale (sert aux liens de suivi et de partage)
APP_URL=https://votre-domaine.com
# Si l'application est dans un sous-dossier (ex. /gestion), sinon laisser vide
APP_BASE_PATH=
# Clé secrète de 64 caractères : php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
APP_TIMEZONE=Africa/Abidjan
FORCE_HTTPS=true

# Base de données (Hostinger : hPanel > Bases de données MySQL)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Pour un essai local sans MySQL : DB_DRIVER=sqlite et DB_SQLITE_PATH=storage/database.sqlite
# MySQL hébergé exigeant une connexion chiffrée (Vercel) : chemin du certificat racine,
# ex. /etc/pki/tls/certs/ca-bundle.crt sur Vercel. Laisser vide sur Hostinger / XAMPP.
DB_SSL_CA=
DB_SQLITE_PATH=storage/database.sqlite

# Création du premier administrateur via /installation (à retirer ensuite)
INSTALL_TOKEN=

# Sécurité
SESSION_IDLE_MINUTES=120
# files (défaut) ou database : obligatoire sur Vercel, où chaque requête peut tomber sur une autre instance
SESSION_DRIVER=files
# Dossier des écritures (journaux, sessions, pièces jointes). Vide = storage/ du projet ; Vercel : /tmp/diarrassouba
STORAGE_PATH=
LOGIN_MAX_ATTEMPTS=5
# Recherches publiques de suivi autorisées par adresse IP et par 10 minutes
TRACKING_RATE_LIMIT=30
SHARE_LINK_TTL_HOURS=72
UPLOAD_MAX_MB=5

# Facturation
DEFAULT_CURRENCY=XOF
# Poids facturable arrondi au palier supérieur, en grammes (100 = 0,1 kg)
BILLING_WEIGHT_STEP_G=100
# Taxe par défaut en points de base (1800 = 18 %). 0 tant que non validé avec le comptable.
DEFAULT_TAX_RATE_BP=0
DEFAULT_DUE_DAYS=15

# Coordonnées imprimées sur les documents et la page de suivi
COMPANY_TAGLINE="Transport aérien de colis : Égypte, Côte d'Ivoire, Afrique de l'Ouest"
COMPANY_ADDRESS="Treichville, Abidjan, Côte d'Ivoire"
COMPANY_PHONE="+225 00 00 00 00 00"
COMPANY_EMAIL=
COMPANY_LEGAL="RCCM : …  CC : …"
COMPANY_PAYMENT_INFO="Espèces, Orange Money, Wave ou virement (indiquer le numéro de facture)."
COMPANY_DEPOT_INFO="Dépôt ouvert du lundi au samedi, 8 h – 18 h."

# Notifications externes (rien n'est envoyé ni simulé tant que ce n'est pas configuré)
NOTIFY_LOG_UNCONFIGURED=true
DEFAULT_PHONE_PREFIX=225
MAIL_ENABLED=false
MAIL_FROM=
# SMS : passerelle HTTP recevant {"to": "+225…", "message": "…"} (Bearer SMS_WEBHOOK_TOKEN)
SMS_DRIVER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# WhatsApp Cloud API officielle (Meta) : modèle approuvé avec un paramètre {{1}}
WHATSAPP_DRIVER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr

BACKUP_KEEP_DAYS=30
